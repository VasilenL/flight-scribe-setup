# Copy to your Scribe app root as `.env` (Scribe reads env via yargs `.env("SCRIBE_APP")`).
# snake_case after the prefix maps to Scribe's camelCase options: SCRIBE_APP_DB_HOST -> dbHost.

SCRIBE_APP_MODE=development
SCRIBE_APP_PORT=1337

# Postgres (matches docker-compose service `postgres`)
SCRIBE_APP_DB_HOST=127.0.0.1
SCRIBE_APP_DB_PORT=5432
SCRIBE_APP_DB_USER=scribe
SCRIBE_APP_DB_PASS=scribe
SCRIBE_APP_DB_NAME=scribe

# Redis schema cache (Scribe uses db 1; Flight uses db 0)
SCRIBE_APP_REDIS_HOST=127.0.0.1
SCRIBE_APP_REDIS_PORT=6379
SCRIBE_APP_REDIS_SCHEMA_DB=1

# Schema server: Scribe fetches each component's JSON Schema from here to validate
# writes. The student-app's Flight backend serves GET /students/schema, so point
# Scribe at Flight. Unset it to fall back to the built-in default table schema.
SCRIBE_APP_SCHEMA_BASE_URL=http://127.0.0.1:3000
# SCRIBE_APP_REQUIRE_SCHEMA=false
