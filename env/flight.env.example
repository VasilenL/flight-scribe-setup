# Copy to your Flight app root as `.env` (Flight reads a `.env` from cwd via dotenv).

FLIGHT_MODE=development
FLIGHT_APP_HOME=.
FLIGHT_PORT=3000
FLIGHT_MAX_WORKERS=2

# Redis (sessions / rate limit / cache) — matches docker-compose service `redis`
FLIGHT_REDIS_HOST=127.0.0.1
FLIGHT_REDIS_PORT=6379

# Change this before anything but local dev — default is a shared, public constant.
FLIGHT_APP_SECRET=change-me-local-dev-only

# Where your business logic reaches the Scribe data tier.
# (Not read by Flight core today — use it in your *.backend.ts when calling Scribe.)
SCRIBE_BASE_URL=http://127.0.0.1:1337
